      },
      "VideoModelsRequest": {
        "additionalProperties": false,
        "properties": {
          "family": {
            "anyOf": [
              {
                "maxLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Family"
          },
          "links": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "maxProperties": 4,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Links"
          },
          "mode": {
            "anyOf": [
              {
                "enum": [
                  "text",
                  "image"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "title": "VideoModelsRequest",
        "type": "object"
      },
      "VideoModelsStatus": {
        "description": "The video model files on this instance (vastcomfy_agent.video_models).",
        "properties": {
          "boot": {
            "title": "Boot",
            "type": "boolean"
          },
          "bytes_done": {
            "title": "Bytes Done",
            "type": "integer"
          },
          "bytes_total": {
            "title": "Bytes Total",
            "type": "integer"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VideoModelInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "state": {
            "enum": [
              "unavailable",
              "not_installed",
              "downloading",
              "ready",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "boot",
          "bytes_done",
          "bytes_total"
        ],
        "title": "VideoModelsStatus",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "vastcomfy-agent",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/destroy": {
      "post": {
        "operationId": "destroy_destroy_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DestroyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Destroy Destroy Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Destroy"
      }
    },
    "/extend": {
      "post": {
        "operationId": "extend_extend_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtendResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Not extendable: a destroy is underway or has failed (code not_extendable)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Extend"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/loras": {
      "post": {
        "description": "Replace the wanted set of extra LoRA files: the missing ones are downloaded in the background (one download\nat a time with the video models), failed ones are retried, unwanted ones deleted while ComfyUI is idle. The\nprogress is `extra_loras` in /status. Links are NOT integrity-pinned.",
        "operationId": "sync_loras_loras_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LorasRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LorasStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "A refused file name or link (codes invalid_lora_name, invalid_model_link, model_link_host_not_allowed, model_link_unsupported_type); nothing changes"
          },
          "404": {
            "description": "Video is not set up on this instance (code video_unavailable)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sync Loras"
      }
    },
    "/status": {
      "get": {
        "operationId": "get_status_status_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Status"
      }
    },
    "/video-models": {
      "post": {
        "description": "Download the missing video model files in the background (single-flight); the progress is in /status.\n`url`: a Hugging Face .safetensors or .gguf link that replaces the base section's diffusion model; `family`\nanother enabled video family, with `mode` and `links` (every expert slot of the mode) replacing its experts.\nLinks are NOT integrity-pinned.",
        "operationId": "start_video_models_video_models_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/VideoModelsRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/VideoModelsStatus"
                    },
                    {
                      "$ref": "#/components/schemas/VideoFamilyStatus"
                    }
                  ],
                  "title": "Response Start Video Models Video Models Post"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "A refused model link (codes invalid_model_link, model_link_host_not_allowed, model_link_unsupported_type, model_link_name_clash)"
          },
          "404": {
