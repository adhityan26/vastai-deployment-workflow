{
  "components": {
    "schemas": {
      "DestroyInfo": {
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "pending": {
            "title": "Pending",
            "type": "boolean"
          }
        },
        "required": [
          "pending",
          "attempts"
        ],
        "title": "DestroyInfo",
        "type": "object"
      },
      "DestroyRequest": {
        "properties": {
          "reason": {
            "default": "manual",
            "enum": [
              "manual",
              "watchdog"
            ],
            "title": "Reason",
            "type": "string"
          }
        },
        "title": "DestroyRequest",
        "type": "object"
      },
      "ExtendRequest": {
        "properties": {
          "kind": {
            "enum": [
              "idle",
              "failsafe"
            ],
            "title": "Kind",
            "type": "string"
          },
          "minutes": {
            "title": "Minutes",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "minutes"
        ],
        "title": "ExtendRequest",
        "type": "object"
      },
      "ExtendResponse": {
        "properties": {
          "deadline": {
            "title": "Deadline",
            "type": "integer"
          },
          "kind": {
            "enum": [
              "idle",
              "failsafe"
            ],
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "deadline"
        ],
        "title": "ExtendResponse",
        "type": "object"
      },
      "Gpu": {
        "properties": {
          "util_percent": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Util Percent"
          },
          "vram_total_mb": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vram Total Mb"
          },
          "vram_used_mb": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vram Used Mb"
          }
        },
        "title": "Gpu",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoraItem": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 64,
            "title": "Name",
            "type": "string"
          },
          "url": {
            "maxLength": 2048,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "name",
          "url"
        ],
        "title": "LoraItem",
        "type": "object"
      },
      "LoraStatus": {
        "description": "One extra LoRA file on this instance (vastcomfy_agent.extra_loras).",
        "properties": {
          "bytes_done": {
            "title": "Bytes Done",
            "type": "integer"
          },
          "bytes_total": {
            "title": "Bytes Total",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha256"
          },
          "size_bytes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size Bytes"
          },
          "state": {
            "enum": [
              "not_installed",
              "downloading",
              "ready",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "name",
          "state",
          "bytes_done",
          "bytes_total"
        ],
        "title": "LoraStatus",
        "type": "object"
      },
      "LorasRequest": {
        "additionalProperties": false,
        "description": "The whole set of extra LoRA files the web app wants on this instance (it replaces the previous set).",
        "properties": {
          "loras": {
            "items": {
              "$ref": "#/components/schemas/LoraItem"
            },
            "maxItems": 64,
            "title": "Loras",
            "type": "array"
          }
        },
        "required": [
          "loras"
        ],
        "title": "LorasRequest",
        "type": "object"
      },
      "LorasStatus": {
        "properties": {
          "digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Digest"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/LoraStatus"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "digest",
          "items"
        ],
        "title": "LorasStatus",
        "type": "object"
      },
      "Progress": {
        "properties": {
          "bytes_done": {
            "title": "Bytes Done",
            "type": "integer"
          },
          "bytes_total": {
            "title": "Bytes Total",
            "type": "integer"
          },
          "file": {
            "title": "File",
            "type": "string"
          },
          "phase": {
