{
  "components": {
    "schemas": {
      "DestroyInfo": {
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "pending": {
            "title": "Pending",
            "type": "boolean"
          }
        },
        "required": [
          "pending",
          "attempts"
        ],
        "title": "DestroyInfo",
        "type": "object"
      },
      "DestroyRequest": {
        "properties": {
          "reason": {
            "default": "manual",
            "enum": [
              "manual",
              "watchdog"
            ],
            "title": "Reason",
            "type": "string"
          }
        },
        "title": "DestroyRequest",
        "type": "object"
      },
      "ExtendRequest": {
        "properties": {
          "kind": {
            "enum": [
              "idle",
              "failsafe"
            ],
            "title": "Kind",
            "type": "string"
          },
          "minutes": {
            "title": "Minutes",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "minutes"
        ],
        "title": "ExtendRequest",
        "type": "object"
      },
      "ExtendResponse": {
        "properties": {
          "deadline": {
            "title": "Deadline",
            "type": "integer"
          },
          "kind": {
            "enum": [
              "idle",
              "failsafe"
            ],
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "deadline"
        ],
        "title": "ExtendResponse",
        "type": "object"
      },
      "Gpu": {
        "properties": {
          "util_percent": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Util Percent"
          },
          "vram_total_mb": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vram Total Mb"
          },
          "vram_used_mb": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vram Used Mb"
          }
        },
        "title": "Gpu",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Progress": {
        "properties": {
          "bytes_done": {
            "title": "Bytes Done",
            "type": "integer"
          },
          "bytes_total": {
            "title": "Bytes Total",
            "type": "integer"
          },
          "file": {
            "title": "File",
            "type": "string"
          },
          "phase": {
            "enum": [
              "nodes",
              "models"
            ],
            "title": "Phase",
            "type": "string"
          }
        },
        "required": [
          "phase",
          "file",
          "bytes_done",
          "bytes_total"
        ],
        "title": "Progress",
        "type": "object"
      },
      "QueueCounts": {
        "properties": {
          "pending": {
            "title": "Pending",
            "type": "integer"
          },
          "running": {
            "title": "Running",
            "type": "integer"
          }
        },
        "required": [
          "running",
          "pending"
        ],
        "title": "QueueCounts",
        "type": "object"
      },
      "State": {
        "enum": [
          "booting",
          "downloading",
          "ready",
          "idle-warning",
          "stopping",
          "failed",
          "destroy_failed"
        ],
        "title": "State",
        "type": "string"
      },
      "Status": {
        "properties": {
          "boot_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Boot At"
          },
          "commit": {
            "title": "Commit",
            "type": "string"
          },
          "destroy": {
            "$ref": "#/components/schemas/DestroyInfo"
          },
          "failsafe_alive": {
            "title": "Failsafe Alive",
            "type": "boolean"
          },
          "failsafe_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failsafe At"
          },
          "gpu": {
            "$ref": "#/components/schemas/Gpu"
          },
          "hard_cap_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hard Cap At"
          },
          "idle_destroy_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idle Destroy At"
          },
          "now": {
            "title": "Now",
            "type": "integer"
          },
          "profile": {
            "title": "Profile",
            "type": "string"
          },
          "progress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Progress"
              },
              {
                "type": "null"
              }
            ]
          },
          "queue": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QueueCounts"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/State"
              },
              {
                "type": "null"
              }
            ]
          },
          "uptime_s": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Uptime S"
          },
          "video_models": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VideoModelsStatus"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "state",
          "reason",
          "progress",
          "now",
          "boot_at",
          "uptime_s",
          "idle_destroy_at",
          "failsafe_at",
          "hard_cap_at",
          "queue",
          "gpu",
          "profile",
          "commit",
          "failsafe_alive",
          "destroy"
        ],
        "title": "Status",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VideoModelsStatus": {
        "description": "The video model files on this instance (vastcomfy_agent.video_models).",
        "properties": {
          "boot": {
            "title": "Boot",
            "type": "boolean"
          },
          "bytes_done": {
            "title": "Bytes Done",
            "type": "integer"
          },
          "bytes_total": {
            "title": "Bytes Total",
            "type": "integer"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "state": {
            "enum": [
              "unavailable",
              "not_installed",
              "downloading",
              "ready",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "boot",
          "bytes_done",
          "bytes_total"
        ],
        "title": "VideoModelsStatus",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "vastcomfy-agent",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/destroy": {
      "post": {
        "operationId": "destroy_destroy_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DestroyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Destroy Destroy Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Destroy"
      }
    },
    "/extend": {
      "post": {
        "operationId": "extend_extend_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtendResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Not extendable: a destroy is underway or has failed (code not_extendable)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Extend"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/status": {
      "get": {
        "operationId": "get_status_status_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Status"
      }
    },
    "/video-models": {
      "post": {
        "description": "Download the missing video model files in the background (single-flight); the progress is in /status.",
        "operationId": "start_video_models_video_models_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoModelsStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No enabled video section (code video_unavailable)"
          },
          "409": {
            "description": "Not now: the instance is not ready, ComfyUI lacks the video node classes, or the disk is too small (codes not_ready, video_nodes_missing, disk_insufficient)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "ComfyUI could not be asked (code comfy_unavailable)"
          }
        },
        "summary": "Start Video Models"
      }
    },
    "/workflows": {
      "get": {
        "operationId": "list_workflows_workflows_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
