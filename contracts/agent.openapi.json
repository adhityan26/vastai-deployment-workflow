              "nodes",
              "models"
            ],
            "title": "Phase",
            "type": "string"
          }
        },
        "required": [
          "phase",
          "file",
          "bytes_done",
          "bytes_total"
        ],
        "title": "Progress",
        "type": "object"
      },
      "QueueCounts": {
        "properties": {
          "pending": {
            "title": "Pending",
            "type": "integer"
          },
          "running": {
            "title": "Running",
            "type": "integer"
          }
        },
        "required": [
          "running",
          "pending"
        ],
        "title": "QueueCounts",
        "type": "object"
      },
      "State": {
        "enum": [
          "booting",
          "downloading",
          "ready",
          "idle-warning",
          "stopping",
          "failed",
          "destroy_failed"
        ],
        "title": "State",
        "type": "string"
      },
      "Status": {
        "properties": {
          "boot_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Boot At"
          },
          "commit": {
            "title": "Commit",
            "type": "string"
          },
          "destroy": {
            "$ref": "#/components/schemas/DestroyInfo"
          },
          "extra_loras": {
            "anyOf": [
              {
