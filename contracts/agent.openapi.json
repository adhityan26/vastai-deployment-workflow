              },
              {
                "type": "null"
              }
            ]
          },
          "failsafe_alive": {
            "title": "Failsafe Alive",
            "type": "boolean"
          },
          "failsafe_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failsafe At"
          },
          "gpu": {
            "$ref": "#/components/schemas/Gpu"
          },
          "hard_cap_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hard Cap At"
          },
          "idle_destroy_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idle Destroy At"
          },
          "now": {
            "title": "Now",
            "type": "integer"
          },
          "profile": {
            "title": "Profile",
            "type": "string"
          },
          "progress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Progress"
              },
              {
                "type": "null"
              }
            ]
          },
          "queue": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QueueCounts"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/State"
              },
              {
                "type": "null"
              }
            ]
          },
          "uptime_s": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Uptime S"
          },
          "video_families": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/VideoFamilyStatus"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Video Families"
          },
          "video_models": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VideoModelsStatus"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "state",
          "reason",
          "progress",
          "now",
          "boot_at",
          "uptime_s",
          "idle_destroy_at",
          "failsafe_at",
          "hard_cap_at",
          "queue",
          "gpu",
          "profile",
          "commit",
          "failsafe_alive",
          "destroy"
        ],
        "title": "Status",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VideoExpertInfo": {
        "description": "One diffusion expert of a video family mode: the pinned file, or a linked one (not integrity-pinned).",
        "properties": {
          "file": {
            "title": "File",
            "type": "string"
          },
          "linked": {
            "title": "Linked",
            "type": "boolean"
          },
          "mode": {
            "enum": [
              "text",
              "image"
            ],
            "title": "Mode",
            "type": "string"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha256"
          },
          "slot": {
            "title": "Slot",
            "type": "string"
          }
        },
        "required": [
          "mode",
          "slot",
          "file",
          "linked"
        ],
        "title": "VideoExpertInfo",
        "type": "object"
      },
      "VideoFamilyStatus": {
        "description": "The model files of one enabled video family on this instance (the base section's too, without experts).",
        "properties": {
          "boot": {
            "title": "Boot",
            "type": "boolean"
          },
          "bytes_done": {
            "title": "Bytes Done",
            "type": "integer"
          },
          "bytes_total": {
            "title": "Bytes Total",
            "type": "integer"
          },
          "experts": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/VideoExpertInfo"
            },
            "title": "Experts",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "state": {
            "enum": [
              "unavailable",
              "not_installed",
              "downloading",
              "ready",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "id",
          "state",
          "boot",
          "bytes_done",
          "bytes_total"
        ],
        "title": "VideoFamilyStatus",
        "type": "object"
      },
      "VideoModelInfo": {
        "description": "The diffusion model the video workflow loads: the pinned one, or a linked one (not integrity-pinned).",
        "properties": {
          "file": {
            "title": "File",
            "type": "string"
          },
          "linked": {
            "title": "Linked",
            "type": "boolean"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha256"
          }
        },
        "required": [
          "file",
          "linked"
