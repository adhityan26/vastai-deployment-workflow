{
  "$defs": {
    "DestroyInfo": {
      "properties": {
        "attempts": {
          "title": "Attempts",
          "type": "integer"
        },
        "last_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error"
        },
        "pending": {
          "title": "Pending",
          "type": "boolean"
        }
      },
      "required": [
        "pending",
        "attempts"
      ],
      "title": "DestroyInfo",
      "type": "object"
    },
    "Gpu": {
      "properties": {
        "util_percent": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Util Percent"
        },
        "vram_total_mb": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vram Total Mb"
        },
        "vram_used_mb": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vram Used Mb"
        }
      },
      "title": "Gpu",
      "type": "object"
    },
    "Progress": {
      "properties": {
        "bytes_done": {
          "title": "Bytes Done",
          "type": "integer"
        },
        "bytes_total": {
          "title": "Bytes Total",
          "type": "integer"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "phase": {
          "enum": [
            "nodes",
            "models"
          ],
          "title": "Phase",
          "type": "string"
        }
      },
      "required": [
        "phase",
        "file",
        "bytes_done",
        "bytes_total"
      ],
      "title": "Progress",
      "type": "object"
    },
    "QueueCounts": {
      "properties": {
        "pending": {
          "title": "Pending",
          "type": "integer"
        },
        "running": {
          "title": "Running",
          "type": "integer"
        }
      },
      "required": [
        "running",
        "pending"
      ],
      "title": "QueueCounts",
      "type": "object"
    },
    "State": {
      "enum": [
        "booting",
        "downloading",
        "ready",
        "idle-warning",
        "stopping",
        "failed",
        "destroy_failed"
      ],
      "title": "State",
      "type": "string"
    },
    "VideoExpertInfo": {
      "description": "One diffusion expert of a video family mode: the pinned file, or a linked one (not integrity-pinned).",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "linked": {
          "title": "Linked",
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "text",
            "image"
          ],
          "title": "Mode",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "slot": {
          "title": "Slot",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "slot",
        "file",
        "linked"
      ],
      "title": "VideoExpertInfo",
      "type": "object"
    },
    "VideoFamilyStatus": {
      "description": "The model files of one enabled video family on this instance (the base section's too, without experts).",
      "properties": {
        "boot": {
          "title": "Boot",
          "type": "boolean"
        },
        "bytes_done": {
          "title": "Bytes Done",
          "type": "integer"
        },
        "bytes_total": {
          "title": "Bytes Total",
          "type": "integer"
        },
        "experts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VideoExpertInfo"
          },
          "title": "Experts",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "state": {
          "enum": [
            "unavailable",
            "not_installed",
            "downloading",
            "ready",
            "failed"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "id",
        "state",
        "boot",
        "bytes_done",
        "bytes_total"
      ],
      "title": "VideoFamilyStatus",
      "type": "object"
    },
    "VideoModelInfo": {
      "description": "The diffusion model the video workflow loads: the pinned one, or a linked one (not integrity-pinned).",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "linked": {
          "title": "Linked",
          "type": "boolean"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "file",
        "linked"
      ],
      "title": "VideoModelInfo",
      "type": "object"
    },
    "VideoModelsStatus": {
      "description": "The video model files on this instance (vastcomfy_agent.video_models).",
      "properties": {
        "boot": {
          "title": "Boot",
          "type": "boolean"
        },
        "bytes_done": {
          "title": "Bytes Done",
          "type": "integer"
        },
        "bytes_total": {
          "title": "Bytes Total",
          "type": "integer"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoModelInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "state": {
          "enum": [
            "unavailable",
            "not_installed",
            "downloading",
            "ready",
            "failed"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "boot",
        "bytes_done",
        "bytes_total"
      ],
      "title": "VideoModelsStatus",
      "type": "object"
    }
  },
  "properties": {
    "boot_at": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Boot At"
    },
    "commit": {
      "title": "Commit",
      "type": "string"
    },
    "destroy": {
      "$ref": "#/$defs/DestroyInfo"
    },
    "failsafe_alive": {
      "title": "Failsafe Alive",
      "type": "boolean"
    },
    "failsafe_at": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Failsafe At"
    },
    "gpu": {
      "$ref": "#/$defs/Gpu"
    },
    "hard_cap_at": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Hard Cap At"
    },
    "idle_destroy_at": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Idle Destroy At"
    },
    "now": {
      "title": "Now",
      "type": "integer"
    },
    "profile": {
      "title": "Profile",
      "type": "string"
    },
    "progress": {
      "anyOf": [
        {
          "$ref": "#/$defs/Progress"
        },
        {
          "type": "null"
        }
      ]
    },
    "queue": {
      "anyOf": [
        {
          "$ref": "#/$defs/QueueCounts"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "anyOf": [
        {
          "$ref": "#/$defs/State"
        },
        {
          "type": "null"
        }
      ]
    },
    "uptime_s": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Uptime S"
    },
    "video_families": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/VideoFamilyStatus"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Video Families"
    },
    "video_models": {
      "anyOf": [
        {
          "$ref": "#/$defs/VideoModelsStatus"
        },
        {
          "type": "null"
        }
