  "required": [
    "state",
    "reason",
    "progress",
    "now",
    "boot_at",
    "uptime_s",
    "idle_destroy_at",
    "failsafe_at",
    "hard_cap_at",
    "queue",
    "gpu",
    "profile",
    "commit",
    "failsafe_alive",
    "destroy"
  ],
  "title": "Status",
  "type": "object"
}
