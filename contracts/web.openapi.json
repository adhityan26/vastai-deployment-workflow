          },
          "502": {
            "description": "ComfyUI unreachable, poll again (code comfy_unavailable); history over WEB_JSON_MAX_BYTES fails the job (code upstream_too_large)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
