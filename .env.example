# Copy to ".env" (never commit it) and fill in. Names only; every key exists in
# contracts/config-schema.yaml. See deploy/web/README.md.

# --- Vast and the instance bootstrap ---
VAST_API_KEY=
REPO_URL=
REPO_COMMIT=
PROFILE=image

# --- Authentik OIDC login ---
# Copy EXACTLY as shown by Authentik, including the trailing slash, e.g.
# https://auth.3dprintingbandung.my.id/application/o/vast-gen/
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Bare origin of the public site: no path, no trailing slash.
WEB_PUBLIC_URL=https://gen.3dprintingbandung.my.id
# At least 32 bytes. Generate with: openssl rand -hex 32
WEB_SESSION_SECRET=
# Seconds of clock skew allowed on ID token times: Authentik may run on another clock, and with 0
# an iat even 1 s in the future is rejected. (The schema default stays 0.)
WEB_OIDC_SKEW_S=5

# --- Tailscale auth key (see README "Tailscale OAuth client") ---
# Preferred: a Tailscale OAuth client (scope Auth Keys: Write, tag tag:gpu). With BOTH set, every
# Start mints its own single-use, ephemeral, pre-approved key and TS_AUTHKEY_FILE is ignored.
# Set both or neither: exactly one set refuses every Start (ts_key_mint_failed).
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=
# Optional (defaults shown):
# TS_OAUTH_TAG=tag:gpu
# TS_KEY_TTL_S=3600
# TS_API_URL=https://api.tailscale.com
# Fallback only when both OAuth keys are empty: a manually created key file on the
# vast-comfy-keys volume.
TS_AUTHKEY_FILE=/run/secrets/ts-authkey

# --- Cost guards (defaults shown) ---
# START_IDLE_MINUTES=30
# START_FAILSAFE_HOURS=3
# START_HARD_CAP_HOURS=6
# START_RATE_LIMIT_PER_HOUR=3
# VAST_START_STUCK_MIN=5         # release a rented machine whose container has not started after this long
# VAST_BAD_MACHINE_TTL_MIN=60     # then avoid that machine on the next Starts for this long (also after a slow boot)
# Slow boots (README "Slow boots"): Vast's advertised download speed does not predict the speed to Hugging Face.
# BOOT_AGENT_GRACE_MIN=10         # release a running instance whose agent never answered this long (< BOOT_TIMEOUT_MIN)
# MODEL_ETA_MIN_OBSERVE_S=120     # watch the model download this long before judging its speed
# BOOT_MAX_DOWNLOAD_ETA_MIN=20    # release when the download would still need longer than this (15 GB: below ~12.5 MB/s) or end after BOOT_TIMEOUT_MIN
# Passed to every new instance (its very first boot step downloads a range of a pinned model and measures it):
# NET_PROBE_BYTES=50331648        # 48 MiB of the largest model, read in two halves; only the second is timed (min 2 MiB)
# NET_PROBE_MIN_MBPS=6            # MB/s; below it twice the instance destroys itself in seconds (slow_network). 0 = off
# DOWNLOAD_CONNECTIONS=4          # parallel byte-range connections per model file (1 = one stream, max 16)

# --- Optional tuning (defaults are in the schema) ---
# WEB_SESSION_TTL_H=8
# WEB_ADMIN_GROUP=authentik Admins
# WEB_MEMBER_GROUP=member
# VAST_MAX_DPH=0.50   # ceiling in USD/h; RTX 5090 offers cost about 0.8-1.1, so raise it (e.g. 1.10) to rent one
# VAST_MIN_VRAM_GB=24
# VAST_DISK_GB=50
# START_OFFER_LIST_MAX=8         # offers listed in the Start dialog's advanced server choice
# VAST_MIN_DOWNLOAD_MBPS=500     # offers with a slower download are skipped (also re-checked locally); ~15 GB of models at 200 Mbps is ~10 min
# VAST_MIN_RELIABILITY=0.98
# VAST_ALLOWED_GPUS=RTX A5000,RTX 3090,RTX 4090   # models in the Start dropdown (Ampere or newer only); add RTX 5090 if wanted
# WEB_GENERATE_RATE_LIMIT_PER_HOUR=60
# GENERATE_MAX_NEGATIVE_PROMPT_CHARS=1000   # negative prompt in the Advanced section (generate and edit)

# --- Image edit with reference images (defaults shown) ---
# EDIT_MAX_REFERENCES=4
# EDIT_REFERENCE_MAX_BYTES=8388608
# EDIT_REFERENCE_MAX_PIXELS=16777216
# EDIT_REFERENCE_MAX_SIDE=8192          # largest width or height of one reference
# EDIT_REFERENCE_TYPES=png,jpeg,webp
# UPSCALE_MAX_OUTPUT_PIXELS=33554432   # largest result of an upscale (width x height)
# UPSCALE_MAX_INTERMEDIATE_PIXELS=33554432   # largest image the upscale model makes before the scale trims it

# --- Live progress and step-by-step preview while an image is made (defaults shown) ---
# COMFY_PREVIEW_METHOD=latent2rgb      # none, latent2rgb (no extra model, rough colours), taesd (needs a TAESD decoder on the instance), auto
# WEB_PROGRESS_ENABLED=true            # false: no websocket to ComfyUI, no step counter, no preview
# WEB_PREVIEW_MAX_BYTES=524288         # newest preview kept per job; a larger frame closes that job's socket
# WEB_PROGRESS_MESSAGE_MAX_BYTES=65536

# --- Vast account credit shown to admins (default shown) ---
# VAST_CREDIT_CACHE_S=60

# --- Boot console (admin only; defaults shown). BOOT_LOG_PATH is set by docker-compose.yml. ---
# BOOT_LOG_MAX_LINES=500          # lines kept (oldest dropped first)
# BOOT_LOG_MAX_LINE_CHARS=400     # characters per line, cut after masking
# BOOT_LOG_POLL_MIN_S=5           # at most one Vast read per this many seconds
# BOOT_LOG_WATCH_S=60             # Vast logs are read only while an admin called the console this recently
# BOOT_LOG_MAX_BYTES=1048576      # largest container log download read
# BOOT_LOG_TAIL_LINES=300         # lines requested from the end of the container log

# --- Usage history (admin only; defaults shown). USAGE_LOG_PATH is set by docker-compose.yml. ---
# USAGE_LOG_MAX_ENTRIES=200       # sessions kept (oldest ended ones dropped first)
# USAGE_REASON_SLACK_S=120        # a deadline this many seconds after the instance was noticed gone still counts as its stop reason

# --- Gallery: saved images in MinIO (see README "Gallery in MinIO"). Empty endpoint = off ---
GALLERY_S3_ENDPOINT=
GALLERY_S3_ACCESS_KEY=
GALLERY_S3_SECRET_KEY=
# Optional (defaults shown):
# GALLERY_S3_BUCKET=vast-gallery
# GALLERY_S3_REGION=us-east-1
# GALLERY_MAX_IMAGES_PER_USER=300
# GALLERY_MAX_BYTES_PER_USER=2147483648
# GALLERY_PAGE_SIZE=12
# GALLERY_SAVE_RATE_LIMIT_PER_HOUR=120
# GALLERY_MAX_CONCURRENT=3
# GALLERY_ADMIN_SCAN_MAX=5000
