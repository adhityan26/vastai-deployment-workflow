# Copy to ".env" (never commit it) and fill in. Names only; every key exists in
# contracts/config-schema.yaml. See deploy/web/README.md.

# --- Vast and the instance bootstrap ---
VAST_API_KEY=
REPO_URL=
REPO_COMMIT=
PROFILE=image

# --- Authentik OIDC login ---
# Copy EXACTLY as shown by Authentik, including the trailing slash, e.g.
# https://auth.3dprintingbandung.my.id/application/o/vast-gen/
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Bare origin of the public site: no path, no trailing slash.
WEB_PUBLIC_URL=https://gen.3dprintingbandung.my.id
# At least 32 bytes. Generate with: openssl rand -hex 32
WEB_SESSION_SECRET=
# Seconds of clock skew allowed on ID token times: Authentik may run on another clock, and with 0
# an iat even 1 s in the future is rejected. (The schema default stays 0.)
WEB_OIDC_SKEW_S=5

# --- Tailscale auth key (file on the vast-comfy-keys volume, see README) ---
TS_AUTHKEY_FILE=/run/secrets/ts-authkey

# --- Cost guards (defaults shown) ---
# START_IDLE_MINUTES=30
# START_FAILSAFE_HOURS=3
# START_HARD_CAP_HOURS=6
# START_RATE_LIMIT_PER_HOUR=3

# --- Optional tuning (defaults are in the schema) ---
# WEB_SESSION_TTL_H=8
# WEB_ADMIN_GROUP=authentik Admins
# WEB_MEMBER_GROUP=member
# VAST_MAX_DPH=0.50
# VAST_MIN_VRAM_GB=24
# VAST_DISK_GB=50
# VAST_MIN_DOWNLOAD_MBPS=500
# VAST_MIN_RELIABILITY=0.98
# VAST_ALLOWED_GPUS=
# WEB_GENERATE_RATE_LIMIT_PER_HOUR=60
