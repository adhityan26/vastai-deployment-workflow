{
  "name": "@vast-comfy/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@vast-comfy/core": "*",
    "fastify": "^5.12.7",
    "jose": "^6.2.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.page.json --noEmit",
